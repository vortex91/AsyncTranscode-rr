{
    "enable_gui": false,
    "database_path": "/app/config/media_database.db",
    "scan_interval_hours": 6,
    "scan_time_of_day": "03:00",
    "radarr_url": "http://YOUR_RADARR_IP:7878",
    "radarr_api_key": "YOUR_RADARR_API_KEY_HERE",
    "sonarr_url": "http://YOUR_SONARR_IP:8989",
    "sonarr_api_key": "YOUR_SONARR_API_KEY_HERE",
    "processed_tags": [
        "AsyncTranscode-rr",
        "TdarrProcessed",
        "HEVC_Processed"
    ],
    "global_source_paths": [
        "/mnt/media/Movies",
        "/mnt/media/Shows"
    ],
    "allowed_extensions": [".mp4", ".mkv", ".avi", ".webm", ".mpeg", ".m4v", ".ogm", ".mov", ".ts"],
    "skip_terms": ["TELESYNC", "DKS", "WWE"],
    "srt_clean_terms": ["Downloaded from", "Official YIFY", "yts", "For best IPTV provider", "RESYNC BY"],
    "servers": [
        {
            "id": "server_1",
            "max_queue": 2,
            "path_2a": "/mnt/media/processing1",
            "path_2b": "/mnt/media/processing1",
            "path_2c": "/mnt/media/completed1",
            "path_failed": "/mnt/media/failed1",
            "path_unmatched": "/mnt/media/unmatched"
        }
    ],
    "default_filter_config": {
        "skip_if_tagged": [
            "AsyncTranscode-rr",
            "TdarrProcessed",
            "HEVC_Processed"
        ],
        "skip_codecs": [
            "hevc",
            "h265"
        ],
        "min_size_bytes": 1048576,
        "max_size_bytes": null,
        "min_audio_channels": 1,
        "min_height": null,
        "max_height": null,
        "min_width": null,
        "max_width": null,
        "modified_after_timestamp": null,
        "modified_before_timestamp": null
    },
    "path_filter_rules": [],
    "media_profile_rules": [],
    "sonarr_unmonitor_rules": []
}